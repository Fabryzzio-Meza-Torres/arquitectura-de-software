    {
      "id": "tree_lesson",
      "type": "text",
      "x": 40,
      "y": 935,
      "width": 730,
      "height": 105,
      "fontSize": 20,
      "text": "P3 precedes A3 only after urgency + service tie.\nAged A1 may own a protected start outside extraction.\nRoot A2 is not the next task.\nRed/black means balance, never business priority.",
      "strokeColor": "#64748b",
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "version": 2,
      "versionNonce": 1539252206,
      "seed": 200033,
      "isDeleted": false,
      "updated": 1792721035739,
      "frameId": null,
      "roundness": null,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "originalText": "P3 precedes A3 only after urgency + service tie.\nAged A1 may own a protected start outside extraction.\nRoot A2 is not the next task.\nRed/black means balance, never business priority.",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aX"
    },
    {
      "id": "tree_invariants",
      "type": "text",
      "x": 820,
      "y": 935,
      "width": 730,
      "height": 105,
      "fontSize": 20,
      "text": "Black root; implicit black NIL leaves.\nNo red parent with a red child.\nEvery root-to-NIL path: 3 black nodes incl. NIL.\nKey change: remove + reinsert. Rebuild from DB.",
      "strokeColor": "#64748b",
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "boundElements": [],
      "link": null,
      "locked": false,
      "version": 2,
      "versionNonce": 456498674,
      "seed": 200034,
      "isDeleted": false,
      "updated": 1792721035739,
      "frameId": null,
      "roundness": null,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "originalText": "Black root; implicit black NIL leaves.\nNo red parent with a red child.\nEvery root-to-NIL path: 3 black nodes incl. NIL.\nKey change: remove + reinsert. Rebuild from DB.",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "aY"
    },
    {
      "id": "complexity",
      "type": "text",
      "x": 40,
      "y": 1085,
      "width": 1480,
      "height": 55,
      "fontSize": 20,
      "text": "Insert/remove: O(log N). Cached minimum: O(1). Feasibility scan can be O(N).\nOne logical READY index per CPU / RAM / GPU class; a global tree does not solve placement.",
      "strokeColor": "#1e40af",
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
