      "fontSize": 25,
      "text": "In-order:   P1  ->  P2  ->  A1  ->  A2  ->  P3  ->  A3  ->  P4",
      "strokeColor": "#1e40af",
      "angle": 0,
      "backgroundColor": "transparent",
      "fillStyle": "solid",
