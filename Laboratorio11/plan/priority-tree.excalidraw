      "roundness": null,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "originalText": "In-order:   P1  ->  P2  ->  A1  ->  A2  ->  P3  ->  A3  ->  P4",
      "containerId": null,
