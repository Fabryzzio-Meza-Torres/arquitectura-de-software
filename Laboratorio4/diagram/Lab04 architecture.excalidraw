      "isDeleted": true,
      "boundElements": [],
      "updated": 1788744148650,
      "link": null,
      "locked": false,
      "text": "| FR-32 | **Teacher feedback on graded\nwork.** A Rural Teacher must be able to\nrecord feedback associated with a student's\ngrade. The feedback must be visible only to\nauthorized users. |",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "| FR-32 | **Teacher feedback on graded work.** A Rural Teacher must be able to record feedback associated with a student's grade. The feedback must be visible only to authorized users. |",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
