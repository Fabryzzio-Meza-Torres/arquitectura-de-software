    {
      "id": "qV-U4cpBH_udHn_ZOM1kd",
      "type": "text",
      "x": -7892.391739579475,
      "y": -2133.73457209244,
      "width": 399.9399719238281,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
