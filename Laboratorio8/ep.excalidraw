      "boundElements": [],
      "updated": 1790909215728,
      "link": null,
      "locked": false,
      "text": "Bottleneck:\nTodos los pedidos\nvalidados requieren\nevaluar stock. Muchos\npedidos simultáneos o\ncon numerosos equipos\npueden saturarlo y\nretrasar su atención.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "3JqguOxRB2hOIDXCeyktj",
      "originalText": "Bottleneck:\nTodos los pedidos validados requieren evaluar stock. Muchos pedidos simultáneos o con numerosos equipos pueden saturarlo y retrasar su atención.",
      "autoResize": true,
      "lineHeight": 1.25
    },
