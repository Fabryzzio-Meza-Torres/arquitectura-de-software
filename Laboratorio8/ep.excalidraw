      "boundElements": [],
      "updated": 1790910133307,
      "link": null,
      "locked": false,
      "text": "Bottleneck:\nLas consultas y\nactualizaciones de\npedidos, programación,\nentrega y pago pueden\ncompetir por\nconexiones y recursos\nde la base de datos.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "XOZBWGLThScjpCBwfbm4u",
      "originalText": "Bottleneck:\nLas consultas y actualizaciones de pedidos, programación, entrega y pago pueden competir por conexiones y recursos de la base de datos.",
      "autoResize": true,
      "lineHeight": 1.25
    },
