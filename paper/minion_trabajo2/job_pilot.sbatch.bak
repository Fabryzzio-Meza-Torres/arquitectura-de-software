#!/usr/bin/env bash
#SBATCH --job-name=minion-pilot
#SBATCH --account=tesis
#SBATCH --partition=data-science
#SBATCH --nodelist=ds001
#SBATCH --gres=shard:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=logs/%x-%j.out
set -euo pipefail
cd "$HOME/minion_trabajo2"
source "$HOME/venvs/minion/bin/activate"
export HF_HUB_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=4
nvidia-smi
# Piloto de funcionamiento: 2k documentos, 1 rep, condiciones representativas.
srun "$HOME/venvs/minion/bin/python" minion_bench.py --dataset fiqa --subset 2000 --quick \
    --conditions L25,NORERANK,F1,F3H,F3NH,F4,F5,F6 \
    --threads 4 --data-dir data --alpha-json alpha.json --out results_pilot/
